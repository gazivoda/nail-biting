# Google OAuth (nail-habit dedicated credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Production: your app domain (e.g. https://stopbiting.today)
# Dev: http://localhost:5173
# Desktop (Electron): http://localhost:3000 (the app loads from the embedded Express server)
APP_URL=http://localhost:5173

PORT=3000

# Paddle credentials (from Paddle Dashboard)
# production or sandbox — used by both server (API base URL) and frontend (Paddle.js)
VITE_PADDLE_ENV=production
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRICE_ID_MONTHLY=
VITE_PADDLE_PRICE_ID_YEARLY=

# Pricing, trial, referrals (WS9). Everything below is optional: leave it empty and the site behaves as it always did.
# Steps, design and limits: docs/agents/ws9-notes.md. Flags: lifetime_plan, gift_plan, referrals, free_tier, regional_pricing.
#
# Trial length in days (a whole number, 1 to 90; default 3). OWNER DECISION PENDING (the plan proposes 7).
# Set it as a REAL environment variable in two places, with the same value: a BUILD argument (the site copy, the
# generated pages and the app bundle are built with it) and a RUNTIME variable (new accounts get it). A line in this
# file is not enough: nothing loads .env before it is read. Then run `TRIAL_DAYS=<n> npm run seo:sync` and commit.
TRIAL_DAYS=
# One-time Paddle prices, created by the owner in the Paddle dashboard. The VITE_ pair is a build argument (the app
# shows the lifetime and gift options only when the id is present), the other pair is read by the server's webhook.
VITE_PADDLE_PRICE_ID_LIFETIME=
VITE_PADDLE_PRICE_ID_GIFT=
PADDLE_PRICE_ID_LIFETIME=
PADDLE_PRICE_ID_GIFT=
# Every price id of THIS app (monthly, yearly, lifetime, gift, and archived ones), comma separated. Required once the
# Paddle account is shared with another product, because the server must only act on this app's payments. Also needed
# for referrals: a payment is only rewarded when its price is known to be ours.
# PADDLE_PRICE_IDS=pri_monthly,pri_yearly,pri_lifetime,pri_gift
# Bonus days each side gets when a referred user's first payment completes (default 30).
REFERRAL_CREDIT_DAYS=
# How long one gift lasts (default 365; the Paddle gift product's price must match), and an optional number of days
# after which an unredeemed gift link stops working (default: never).
GIFT_PLAN_DAYS=
GIFT_CODE_EXPIRY_DAYS=
# Free plan limits, OWNER DECISION PENDING (placeholders 30 and 7): minutes of detection a day, days of history shown.
FREE_TIER_DETECTION_MINUTES=
FREE_TIER_HISTORY_DAYS=

# Resend transactional email (get key at resend.com)
RESEND_API_KEY=
# Sender on a Resend-verified domain, e.g. Stop Biting <hello@stopbiting.today>
EMAIL_FROM=

# More ways to sign in (WS8). Each one is offered only when BOTH its flag is in
# FEATURE_FLAGS (signin_magic_link, signin_apple, signin_microsoft) AND its
# variables below are set; otherwise the site shows Google sign-in only, as before.
# Setup steps and the exact values to register: docs/agents/ws8-notes.md
#
# Emailed sign-in link: needs RESEND_API_KEY and EMAIL_FROM above (a sender on a
# domain verified in Resend), and Resend's click tracking OFF for that domain.
#
# Sign in with Apple. Services ID, team id, key id and the .p8 key's contents
# (newlines may be written as \n). Return URL to register with Apple:
#   <APP_URL>/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Apple checks the domain by fetching /.well-known/apple-developer-domain-association.txt.
# Paste the downloaded file's contents here; the server serves it at that path (a
# file in public/ would not be served, dot directories are ignored). Leave empty
# once Apple has verified the domain, or keep it: it exposes only that text.
APPLE_DOMAIN_VERIFICATION=
#
# Sign in with Microsoft. Redirect URI to register (platform: Web):
#   <APP_URL>/api/auth/microsoft/callback
# MICROSOFT_TENANT: common (work, school and personal accounts; the default),
# consumers (personal only), organizations (work and school only) or one tenant id.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Formspree contact form ID (the part after /f/ in the formspree endpoint)
VITE_FORMSPREE_FORM_ID=

# Feature flags: a comma-separated list of flags to turn ON. Anything not listed is
# OFF, so leave this empty until a feature has been reviewed. Read when the server
# starts: edit the value, restart the server, no rebuild. The client reads the result
# from GET /api/features. Flag details: src/features/registry.ts.
# Example: FEATURE_FLAGS=event_sync,data_backup
#
#   WS1   detection_behaviors, experimental
#   WS2   hrt_coaching, urge_timer
#   WS3   false_positive_controls
#   WS4   event_sync, data_backup
#   WS5   insights, photo_diary, weekly_email
#   WS6   phone_companion
#   WS7   background_watching, desktop_app
#   WS8   signin_magic_link, signin_apple, signin_microsoft
#   WS9   free_tier, lifetime_plan, gift_plan, referrals, regional_pricing
#   WS10  share_links
#   WS11  compare_competitors, social_proof
#   WS12  locale_es, locale_de, locale_pt_br
FEATURE_FLAGS=
